{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "debug_GCC_NUCLEO-C542RC",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "${presetName}",
                "TOOLCHAIN_FILE": "GCC.14.3.1.cmake",
